generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model audit_logs {
  id          String   @id
  user_id     String
  action      String
  entity_type String
  entity_id   String
  details     String?
  created_at  DateTime @default(now())
  users       users    @relation(fields: [user_id], references: [id])
}

model edit_requests {
  id         String            @id
  set_id     String
  judge_id   String
  reason     String
  status     EditRequestStatus @default(PENDING)
  created_at DateTime          @default(now())
  updated_at DateTime
  users      users             @relation(fields: [judge_id], references: [id])
  judge_sets judge_sets        @relation(fields: [set_id], references: [id], onDelete: Cascade)
}

model events {
  id                  String                @id
  name                String
  description         String?
  start_date          DateTime?
  end_date            DateTime?
  time_per_project    Int                   @default(180)
  set_size            Int                   @default(5)
  status              EventStatus           @default(SETUP)
  created_at          DateTime              @default(now())
  is_active           Boolean               @default(false)
  flags               flags[]
  judge_sets          judge_sets[]
  projects            projects[]
  rejudge_assignments rejudge_assignments[]
  tracks              tracks[]
}

model feedbacks {
  id         String     @id
  set_id     String
  project_id String
  judge_id   String
  comment    String
  created_at DateTime   @default(now())
  users      users      @relation(fields: [judge_id], references: [id])
  projects   projects   @relation(fields: [project_id], references: [id])
  judge_sets judge_sets @relation(fields: [set_id], references: [id], onDelete: Cascade)
}

model flags {
  id          String     @id
  event_id    String
  project_id  String
  flagged_by  String
  reason      String
  status      FlagStatus @default(OPEN)
  admin_notes String?
  created_at  DateTime   @default(now())
  events      events     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  users       users      @relation(fields: [flagged_by], references: [id])
  projects    projects   @relation(fields: [project_id], references: [id])
}

model judge_set_projects {
  id         String     @id
  set_id     String
  project_id String
  sort_order Int
  projects   projects   @relation(fields: [project_id], references: [id])
  judge_sets judge_sets @relation(fields: [set_id], references: [id], onDelete: Cascade)

  @@unique([set_id, project_id])
}

model judge_sets {
  id                 String               @id
  event_id           String
  judge_id           String?
  column             Int
  set_number         Int
  status             SetStatus            @default(UNASSIGNED)
  created_at         DateTime             @default(now())
  edit_requests      edit_requests[]
  feedbacks          feedbacks[]
  judge_set_projects judge_set_projects[]
  events             events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  users              users?               @relation(fields: [judge_id], references: [id])
  scores             scores[]
  stack_rank_votes   stack_rank_votes[]
  track_nominations  track_nominations[]
}

model projects {
  id                 String               @id
  event_id           String
  team_id            String
  title              String
  description        String?
  demo_link          String?
  video_url          String?
  room_number        String?
  team_number        String?
  leader_name        String?
  status             ProjectStatus        @default(SUBMITTED)
  created_at         DateTime             @default(now())
  feedbacks          feedbacks[]
  flags              flags[]
  judge_set_projects judge_set_projects[]
  events             events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  users              users                @relation(fields: [team_id], references: [id])
  scores             scores[]
  stack_rank_votes   stack_rank_votes[]
  track_nominations  track_nominations[]
}

model rejudge_assignments {
  id               String        @id
  event_id         String
  judge_id         String
  tied_project_ids String
  status           RejudgeStatus @default(PENDING)
  created_at       DateTime      @default(now())
  events           events        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  users            users         @relation(fields: [judge_id], references: [id])
}

model scores {
  id                 String     @id
  set_id             String
  project_id         String
  judge_id           String
  completion         Int
  originality        Int
  learning           Int
  design             Int
  technology         Int
  total              Int
  created_at         DateTime   @default(now())
  time_spent_seconds Int        @default(0)
  users              users      @relation(fields: [judge_id], references: [id])
  projects           projects   @relation(fields: [project_id], references: [id])
  judge_sets         judge_sets @relation(fields: [set_id], references: [id], onDelete: Cascade)

  @@unique([set_id, project_id, judge_id])
}

model stack_rank_votes {
  id         String     @id
  set_id     String
  judge_id   String
  project_id String
  rank       Int
  points     Int
  created_at DateTime   @default(now())
  users      users      @relation(fields: [judge_id], references: [id])
  projects   projects   @relation(fields: [project_id], references: [id])
  judge_sets judge_sets @relation(fields: [set_id], references: [id], onDelete: Cascade)

  @@unique([set_id, judge_id, rank])
}

model track_nominations {
  id         String     @id
  set_id     String
  project_id String
  judge_id   String
  track_id   String
  created_at DateTime   @default(now())
  users      users      @relation(fields: [judge_id], references: [id])
  projects   projects   @relation(fields: [project_id], references: [id])
  judge_sets judge_sets @relation(fields: [set_id], references: [id], onDelete: Cascade)
  tracks     tracks     @relation(fields: [track_id], references: [id])

  @@unique([set_id, project_id, judge_id, track_id])
}

model tracks {
  id                String              @id
  event_id          String
  name              String
  description       String?
  color             String              @default("#3B82F6")
  track_nominations track_nominations[]
  events            events              @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model users {
  id                  String                @id
  name                String
  email               String                @unique
  password_hash       String
  role                Role
  created_at          DateTime              @default(now())
  phone               String?
  password_plain      String?
  audit_logs          audit_logs[]
  edit_requests       edit_requests[]
  feedbacks           feedbacks[]
  flags               flags[]
  judge_sets          judge_sets[]
  projects            projects[]
  rejudge_assignments rejudge_assignments[]
  scores              scores[]
  stack_rank_votes    stack_rank_votes[]
  track_nominations   track_nominations[]
}

enum EditRequestStatus {
  PENDING
  APPROVED
  DENIED
  USED
}

enum EventStatus {
  SETUP
  JUDGING
  COMPLETED
}

enum FlagStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum ProjectStatus {
  SUBMITTED
  UNDER_REVIEW
  FLAGGED
  SCORED
  IN_JUDGING
  JUDGING_COMPLETE
}

enum RejudgeStatus {
  PENDING
  COMPLETED
}

enum Role {
  ADMIN
  JUDGE
  TEAM
}

enum SetStatus {
  UNASSIGNED
  IN_PROGRESS
  COMPLETED
}
