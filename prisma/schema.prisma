generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  eventId    String   @map("event_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model EditRequest {
  id        String            @id @default(uuid())
  setId     String            @map("set_id")
  judgeId   String            @map("judge_id")
  reason    String
  status    EditRequestStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @map("updated_at")
  judge     User              @relation(fields: [judgeId], references: [id])
  set       JudgeSet          @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("edit_requests")
}

model Event {
  id             String              @id @default(uuid())
  name           String
  description    String?
  startDate      DateTime?           @map("start_date")
  endDate        DateTime?           @map("end_date")
  timePerProject Int                 @default(180) @map("time_per_project")
  setSize        Int                 @default(5) @map("set_size")
  status         EventStatus         @default(SETUP)
  isActive       Boolean             @default(false) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  auditLogs      AuditLog[]
  flags          Flag[]
  judgeSets      JudgeSet[]
  projects       Project[]
  rejudgeAssignments RejudgeAssignment[]
  tracks         Track[]

  @@map("events")
}

model Feedback {
  id        String   @id @default(uuid())
  setId     String   @map("set_id")
  projectId String   @map("project_id")
  judgeId   String   @map("judge_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  judge     User     @relation(fields: [judgeId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  set       JudgeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Flag {
  id         String     @id @default(uuid())
  eventId    String     @map("event_id")
  projectId  String     @map("project_id")
  flaggedBy  String     @map("flagged_by")
  reason     String
  status     FlagStatus @default(OPEN)
  adminNotes String?    @map("admin_notes")
  createdAt  DateTime   @default(now()) @map("created_at")
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator    User       @relation("FlagCreator", fields: [flaggedBy], references: [id])
  project    Project    @relation(fields: [projectId], references: [id])

  @@map("flags")
}

model JudgeSetProject {
  id        String   @id @default(uuid())
  setId     String   @map("set_id")
  projectId String   @map("project_id")
  sortOrder Int      @map("sort_order")
  project   Project  @relation(fields: [projectId], references: [id])
  set       JudgeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, projectId])
  @@map("judge_set_projects")
}

model JudgeSet {
  id             String            @id @default(uuid())
  eventId        String            @map("event_id")
  judgeId        String?           @map("judge_id")
  column         Int
  setNumber      Int               @map("set_number")
  status         SetStatus         @default(UNASSIGNED)
  createdAt      DateTime          @default(now()) @map("created_at")
  editRequests   EditRequest[]
  feedbacks      Feedback[]
  projects       JudgeSetProject[]
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge          User?             @relation(fields: [judgeId], references: [id])
  scores         Score[]
  stackRankVotes StackRankVote[]
  nominations    TrackNomination[]

  @@map("judge_sets")
}

model Project {
  id               String            @id @default(uuid())
  eventId          String            @map("event_id")
  teamId           String            @map("team_id")
  title            String
  description      String?
  demoLink         String?           @map("demo_link")
  videoUrl         String?           @map("video_url")
  roomNumber       String?           @map("room_number")
  teamNumber       String?           @map("team_number")
  leaderName       String?           @map("leader_name")
  status           ProjectStatus     @default(SUBMITTED)
  createdAt        DateTime          @default(now()) @map("created_at")
  feedbacks        Feedback[]
  flags            Flag[]
  judgeSetProjects JudgeSetProject[]
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team             User              @relation(fields: [teamId], references: [id])
  scores           Score[]
  stackRankVotes   StackRankVote[]
  trackNominations TrackNomination[]

  @@unique([eventId, teamNumber])
  @@map("projects")
}

model RejudgeAssignment {
  id             String        @id @default(uuid())
  eventId        String        @map("event_id")
  judgeId        String        @map("judge_id")
  tiedProjectIds String        @map("tied_project_ids")
  status         RejudgeStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge          User          @relation(fields: [judgeId], references: [id])

  @@map("rejudge_assignments")
}

model Score {
  id               String   @id @default(uuid())
  setId            String   @map("set_id")
  projectId        String   @map("project_id")
  judgeId          String   @map("judge_id")
  completion       Int
  originality      Int
  learning         Int
  design           Int
  technology       Int
  total            Int
  createdAt        DateTime @default(now()) @map("created_at")
  timeSpentSeconds Int      @default(0) @map("time_spent_seconds")
  judge            User     @relation(fields: [judgeId], references: [id])
  project          Project  @relation(fields: [projectId], references: [id])
  set              JudgeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, projectId, judgeId])
  @@map("scores")
}

model StackRankVote {
  id        String   @id @default(uuid())
  setId     String   @map("set_id")
  judgeId   String   @map("judge_id")
  projectId String   @map("project_id")
  rank      Int
  points    Int
  createdAt DateTime @default(now()) @map("created_at")
  judge     User     @relation(fields: [judgeId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  set       JudgeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, judgeId, rank])
  @@map("stack_rank_votes")
}

model TrackNomination {
  id        String   @id @default(uuid())
  setId     String   @map("set_id")
  projectId String   @map("project_id")
  judgeId   String   @map("judge_id")
  trackId   String   @map("track_id")
  createdAt DateTime @default(now()) @map("created_at")
  judge     User     @relation(fields: [judgeId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  set       JudgeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id])

  @@unique([setId, projectId, judgeId, trackId])
  @@map("track_nominations")
}

model Track {
  id          String            @id @default(uuid())
  eventId     String            @map("event_id")
  name        String
  description String?
  color       String            @default("#3B82F6")
  nominations TrackNomination[]
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("tracks")
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  passwordHash       String              @map("password_hash")
  role               Role
  createdAt          DateTime            @default(now()) @map("created_at")
  phone              String?
  passwordPlain      String?             @map("password_plain")
  auditLogs          AuditLog[]
  editRequests       EditRequest[]
  feedbacks          Feedback[]
  flagsCreated       Flag[]              @relation("FlagCreator")
  judgeSets          JudgeSet[]
  projects           Project[]
  rejudgeAssignments RejudgeAssignment[]
  scores             Score[]
  stackRankVotes     StackRankVote[]
  trackNominations   TrackNomination[]

  @@map("users")
}

enum EditRequestStatus {
  PENDING
  APPROVED
  DENIED
  USED
}

enum EventStatus {
  SETUP
  JUDGING
  COMPLETED
}

enum FlagStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum ProjectStatus {
  SUBMITTED
  UNDER_REVIEW
  FLAGGED
  SCORED
  IN_JUDGING
  JUDGING_COMPLETE
}

enum RejudgeStatus {
  PENDING
  COMPLETED
}

enum Role {
  ADMIN
  JUDGE
  TEAM
}

enum SetStatus {
  UNASSIGNED
  IN_PROGRESS
  COMPLETED
}
