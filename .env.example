# Neon PostgreSQL — pooled connection (for application runtime)
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require"

# Neon PostgreSQL — direct connection (for Prisma migrations/db push)
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require"

JWT_SECRET="change-me-in-production"
PORT=3001
